# E2E Test Environment Variables

# Base URL for the application under test
# Default: http://localhost:8080
E2E_BASE_URL=http://localhost:8080

# Test user credentials for authentication tests
# These should match a valid user in your test environment
E2E_TEST_EMAIL=test@example.com
E2E_TEST_PASSWORD=TestPassword123!

# Test organization ID
# Used for tests that navigate to specific org pages
E2E_TEST_ORG_ID=test-org-uuid

# Skip auto-starting the web server during tests
# Set to "true" when the server is already running (CI environments)
# Default: undefined (server will auto-start)
E2E_SKIP_WEBSERVER=false
